# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobhunter
DB_USERNAME=jobhunter
DB_PASSWORD=jobhunter

# Aplicacao
PORT=8080
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# Seguranca (a implementacao JWT entra na Fase 2)
JWT_SECRET=troque-por-um-segredo-forte-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRATION=900

# Integracao dos coletores
INGEST_TOKEN=troque-por-um-token-de-integracao

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_NOTIFY_ON_INGEST=true

# Firebase Cloud Messaging (Fase 5)
FIREBASE_CREDENTIALS_PATH=
